# Graphics stack loaded into apps and surfaceflinger (same process HAL)
/(vendor|system/vendor)/lib/hw/gralloc\.msm8226\.so                          u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib/libgsl\.so                                       u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib/libmemalloc\.so                                  u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib/libqdutils\.so                                   u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib/libqdutils_gralloc\.so                           u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib/libqdMetaData\.so                                u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib/libadreno_utils\.so                              u:object_r:same_process_hal_file:s0
