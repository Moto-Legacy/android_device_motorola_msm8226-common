# Root mount points
/firmware(/.*)?                                 u:object_r:firmware_file:s0
/fsg(/.*)?                                      u:object_r:firmware_file:s0
/pds(/.*)?                                      u:object_r:tmp_root_mount_file:s0
/persist(/.*)?                                  u:object_r:tmp_root_mount_file:s0
/tombstones                                     u:object_r:rootfs:s0

# Devices
/dev/kgsl-3d0                                   u:object_r:gpu_device:s0
/dev/diag                                       u:object_r:diag_device:s0
/dev/qseecom                                    u:object_r:qseecom_device:s0
/dev/smem_log                                   u:object_r:smem_log_device:s0
/dev/smd[0-9]+                                  u:object_r:smd_device:s0
/dev/smdcntl[0-9]+                              u:object_r:smd_device:s0
/dev/msm_rtac                                   u:object_r:audio_device:s0
/dev/block/mmcblk0rpmb                          u:object_r:rpmb_device:s0
/dev/socket/qmux_[a-z]+(/.*)?                   u:object_r:qmuxd_socket:s0

